-- Problem5: Contest Leaderboard
-- Concepts: JOIN, GROUP BY, SUBQUERY, AGGREGATION


Problem Summary:
Calculate total score of each hacker.

Rules:
1. For each challenge, take MAX(score)
2. Sum all max scores per hacker
3. Exclude hackers with total score = 0
4. Sort by:
   - total_score DESC
   - hacker_id ASC


SELECT h.hacker_id, h.name, SUM(s.max_score) AS total_score
FROM Hackers h
JOIN (
    SELECT hacker_id, challenge_id, MAX(score) AS max_score
    FROM Submissions
    GROUP BY hacker_id, challenge_id
) s
ON h.hacker_id = s.hacker_id
GROUP BY h.hacker_id, h.name
HAVING total_score > 0
ORDER BY total_score DESC, h.hacker_id ASC;
