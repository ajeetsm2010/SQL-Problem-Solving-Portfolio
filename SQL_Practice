-- Problem3: Ollivander's Inventory
-- Platform: HackerRank
-- Concept: JOIN + Subquery

SELECT w.id, wp.age, w.coins_needed, w.power
FROM Wands w
JOIN Wands_Property wp
ON w.code = wp.code
WHERE wp.is_evil = 0
AND w.coins_needed = (
    SELECT MIN(w2.coins_needed)
    FROM Wands w2
    JOIN Wands_Property wp2
    ON w2.code = wp2.code
    WHERE wp2.is_evil = 0
    AND w2.power = w.power
    AND wp2.age = wp.age
)
ORDER BY w.power DESC, wp.age DESC;



